{
  "name": "picomcp",
  "version": "0.1.0",
  "description": "MCP servers, at pico scale. A zero-dependency TypeScript framework for Model Context Protocol servers.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "ai",
    "agents",
    "tools",
    "claude",
    "standard-schema",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://picomcp.github.io/picomcp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/picomcp/picomcp.git"
  },
  "bugs": "https://github.com/picomcp/picomcp/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "picomcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/size.ts",
    "lint:pkg": "publint && attw --pack . --profile esm-only",
    "check": "npm run typecheck && npm run test && npm run build && npm run size && npm run lint:pkg",
    "site": "node site/build.ts",
    "site:dev": "node --watch-path=site/docs --watch-path=site/assets --watch-path=site/build.ts --watch-path=site/theme.ts site/build.ts --serve",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26.6.6",
    "@valibot/to-json-schema": "^1.8.0",
    "arktype": "^2.2.9",
    "marked": "^18.1.3",
    "publint": "^0.3.25",
    "shiki": "^4.6.0",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
